# Необязательно: без ключей ИИ приложение использует резервный режим.
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Gmail-отправитель уведомлений. Получатель задаётся в Аккаунт → Уведомления о поломках.
# Используйте пароль приложения Google, а не обычный пароль от почты.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
